name: NIKKA X MD

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  bot:
    runs-on: ubuntu-latest
    timeout-minutes: 360

    steps:
      - name: Checkout NIKKA X MD
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install Dependencies
        run: npm install --legacy-peer-deps

      - name: Start NIKKA X MD
        env:
          SASA_DEV_API_KEY: ${{ secrets.SASA_DEV_API_KEY }}
          SASA_API_KEY: ${{ secrets.SASA_API_KEY }}
          SASA_YTMP3_API_KEY: ${{ secrets.SASA_YTMP3_API_KEY }}
          SASA_TTS_API_KEY: ${{ secrets.SASA_TTS_API_KEY }}
        run: npm start
